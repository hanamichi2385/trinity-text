<Project>
	<PropertyGroup>
		<Authors>hanamichi2385</Authors>
		<Owners>hanamichi2385</Owners>
		<Copyright>Copyright © hanamichi2385 2022-2026</Copyright>
		<ProductVersion>1.4.0</ProductVersion>
		<AssemblyVersion>1.4.0</AssemblyVersion>
		<FileVersion>1.4.0</FileVersion>
		<Version>1.4.0</Version>
		<RepositoryUrl>https://github.com/hanamichi2385/trinity-text</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/hanamichi2385/trinity-text</PackageProjectUrl>
		<PackageTags>trinity-text cms globalization htmllocalizer textlocalizer</PackageTags>
		<SignAssembly>False</SignAssembly>
		<AssemblyOriginatorKeyFile>..\..\SolutionItems\trinity-text.snk</AssemblyOriginatorKeyFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<!-- symbols + SourceLink (built into the .NET SDK) -->
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
	</PropertyGroup>
	<PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>
	<ItemGroup>
		<None Include="..\..\SolutionItems\README.md" Pack="true" PackagePath="\"/>
	</ItemGroup>
</Project>